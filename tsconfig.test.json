{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "CommonJS",
		"moduleResolution": "Node",
		"rootDir": "./",
		"outDir": "./dist/test/",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	},
	"exclude": ["node_modules", "dist"],
	"include": ["src/**/*", "tests/**/*"]
}
